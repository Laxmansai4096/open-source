# ==============================================================================
# OMNISYNAPSE-TITAN: ENTERPRISE FDE CONFIGURATION
# ==============================================================================

# OPERATION MODE: 'azure' for live cloud endpoints, 'local' for zero-cost offline mock engine
RUN_MODE=local

# ------------------------------------------------------------------------------
# AZURE OPENAI & FOUNDATION MODEL GATEWAY
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Open-Source Fallback Endpoint (vLLM / Ollama for zero-downtime 429 failover)
FALLBACK_OPENSOURCE_ENDPOINT=http://localhost:11434/v1
FALLBACK_OPENSOURCE_MODEL=llama3.3:70b

# ------------------------------------------------------------------------------
# AZURE AI SEARCH (HYBRID RAG + RBAC)
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_admin_key
AZURE_SEARCH_INDEX_NAME=enterprise-contract-vault

# ------------------------------------------------------------------------------
# AZURE DOCUMENT INTELLIGENCE
# ------------------------------------------------------------------------------
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your_doc_intel_key

# ------------------------------------------------------------------------------
# AZURE AI CONTENT SAFETY & SECURITY
# ------------------------------------------------------------------------------
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-content-safety.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=your_content_safety_key

# ------------------------------------------------------------------------------
# ENTERPRISE ERP CLIENT API (MOCK / LIVE REST)
# ------------------------------------------------------------------------------
ERP_API_BASE_URL=http://localhost:8000/api/v1/erp
ERP_API_BEARER_TOKEN=enterprise-secret-erp-token-xyz

# ------------------------------------------------------------------------------
# CACHE & CONCURRENCY RATE LIMITING
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_RPM=100
